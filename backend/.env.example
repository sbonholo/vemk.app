# Beija Backend Environment Variables

# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change-me-to-a-long-random-string
OTP_TTL_SECONDS=300
# When true, the verify-otp endpoint accepts the literal code "000000" for any phone.
# Use only in development. Leave the OTP returned in the response when DEV_RETURN_OTP=true.
DEV_RETURN_OTP=true

# Database
DATABASE_FILE=./data/beija.db

# Uploads
UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:4000

# CORS (comma-separated origins). Leave empty to allow all in dev.
CORS_ORIGINS=http://localhost:5173

# SMS provider (mock for MVP). Swap to Twilio / Zenvia / Movile later.
SMS_PROVIDER=mock
